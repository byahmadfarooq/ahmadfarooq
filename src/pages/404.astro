---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 | This page is not here"
  description="The link may be old or mistyped. Here is where to go instead."
  noindex={true}
>
  <section class="section" style="border-bottom:none; padding-top: clamp(4rem, 3rem + 4vw, 8rem); padding-bottom: clamp(4rem, 3rem + 4vw, 8rem);">
    <div class="site-container">
      <div class="error-page-section reveal-on-scroll">
        <span class="section-tag">404</span>
        <h1 class="error-heading">This page is not here.</h1>
        <p class="error-line">The link may be old or mistyped. Here is where to go instead.</p>
        <ul class="error-links" role="list">
          <li><a href="/">Home &rarr;</a></li>
          <li><a href="/#work">Selected work &rarr;</a></li>
          <li><a href="/#contact">Contact &rarr;</a></li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
