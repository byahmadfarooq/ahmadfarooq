---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTABand from '../components/CTABand.astro';
import ClientsGrid from '../components/ClientsGrid.astro';
import home from '../content/pages/home.json';
---

<BaseLayout
  title="Ahmad Farooq | LinkedIn Growth for Coaches & Consultants"
  description="I help coaches and solo consultants turn LinkedIn into a predictable client pipeline through daily authoritative content, strategic outreach, and complete profile rewrites."
  canonicalPath="/"
>
  <Header />

  <main>

    <!-- 1. HERO -->
    <section aria-label="Introduction" class="section" style="padding-top: 60px; padding-bottom: 50px;">
      <div class="hero-wrap">
        <div class="hero-content">
          <span class="hero-label">{home.heroLabel}</span>
          <h1 class="hero-title" style="font-size: clamp(2rem, 4vw, 2.85rem); line-height: 1.18; margin: 12px 0 16px 0;">{home.heroTitle}</h1>
          <p class="hero-tagline" style="font-size: 1.05rem; line-height: 1.6; max-width: 580px; margin-bottom: 28px;">{home.heroTagline}</p>

          <div class="hero-actions" style="margin-bottom: 0;">
            <a href="/book" class="btn btn-primary">{home.heroCTA1Text}</a>
          </div>
        </div>

        <div class="hero-visual">
          <div class="profile-frame">
            <img src="/images/ahmad-profile.png" alt="Ahmad Farooq, LinkedIn Growth Specialist and Builder" width="340" height="440" loading="eager">
          </div>
        </div>
      </div>
    </section>

    <!-- WORKED WITH -->
    <ClientsGrid />

    <!-- 2. PROOF (CASE STUDIES) -->
    <section id="work" class="section" style="background: var(--bg-dark); border-top: 2px solid var(--border); border-bottom: 2px solid var(--border);" aria-labelledby="cases-heading">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-label">Case Studies</span>
          <h2 id="cases-heading" set:html={home.casesHeadline.replace(/\n/g, '<br>')}></h2>
          <p style="margin-top: 10px; font-size: 0.95rem; color: var(--text-muted);">
            Real performance analytics and commercial outcomes from client engagements.
          </p>
        </div>

        <div class="case-studies-list" style="display: flex; flex-direction: column; gap: 40px;">
          
          <!-- Case Study 1: Linda Bretherton (Wellness Coach) -->
          <article class="case-study-card reveal" style="background: var(--bg); border: 2px solid var(--border); border-radius: 8px; padding: clamp(20px, 3vw, 32px); box-shadow: 4px 4px 0 var(--border);">
            <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 8px; margin-bottom: 14px; border-bottom: 1px solid var(--border); padding-bottom: 12px;">
              <div>
                <span class="tag tag-orange" style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700;">Case Study 1</span>
                <h3 style="font-size: 1.4rem; margin-top: 8px;">Linda Bretherton (Wellness Coach): 101,050 Impressions &amp; 19 New Clients</h3>
              </div>
              <span style="font-size: 0.82rem; font-family: var(--font-heading); color: var(--text-muted); font-weight: 600;">May to August 2024</span>
            </div>

            <p style="font-size: 0.95rem; line-height: 1.6; color: var(--text); margin-bottom: 18px;">
              <strong>Strategic Scope:</strong> Executed an end-to-end positioning transformation and inbound distribution system. Architected a full before/after profile redesign, authored daily niche-specific thought leadership posts, conducted 20 to 25 strategic daily peer discussions, and executed 10 to 15 targeted connection touches per day.
            </p>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 14px; margin-bottom: 24px;">
              <div style="background: var(--bg-dark); border: 1px solid var(--border); border-radius: 6px; padding: 12px 14px;">
                <div style="font-family: var(--font-heading); font-size: 1.5rem; font-weight: 800; color: var(--orange);">101,050</div>
                <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 2px;">Impressions (90 Days)</div>
              </div>
              <div style="background: var(--bg-dark); border: 1px solid var(--border); border-radius: 6px; padding: 12px 14px;">
                <div style="font-family: var(--font-heading); font-size: 1.5rem; font-weight: 800; color: var(--text);">19 Clients</div>
                <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 2px;">New Clients Acquired</div>
              </div>
              <div style="background: var(--bg-dark); border: 1px solid var(--border); border-radius: 6px; padding: 12px 14px;">
                <div style="font-family: var(--font-heading); font-size: 1.5rem; font-weight: 800; color: var(--text);">+3%</div>
                <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 2px;">Amazon Book Sales Lift</div>
              </div>
              <div style="background: var(--bg-dark); border: 1px solid var(--border); border-radius: 6px; padding: 12px 14px;">
                <div style="font-family: var(--font-heading); font-size: 1.5rem; font-weight: 800; color: var(--text);">Done-for-you</div>
                <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 2px;">Daily Mon–Fri System</div>
              </div>
            </div>

            <!-- Visual Gallery for Case 1 -->
            <div style="margin-top: 20px;">
              <p style="font-family: var(--font-heading); font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin-bottom: 12px;">Verified Analytics &amp; Profile Redesigns:</p>
              <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px;">
                <div style="border: 1px solid var(--border); border-radius: 6px; overflow: hidden; background: #fff;">
                  <img src="/images/case-1/Portfolio Profile 1 (1).png" alt="Linda Bretherton LinkedIn 90-day impressions report displaying 101,050 impressions" loading="lazy" style="width: 100%; height: auto; display: block;">
                </div>
                <div style="border: 1px solid var(--border); border-radius: 6px; overflow: hidden; background: #fff;">
                  <img src="/images/case-1/Portfolio Profile 1 (2).png" alt="Audience engagement and impression metrics chart" loading="lazy" style="width: 100%; height: auto; display: block;">
                </div>
                <div style="border: 1px solid var(--border); border-radius: 6px; overflow: hidden; background: #fff;">
                  <img src="/images/case-1/Portfolio Profile 1 (3).png" alt="Profile banner before and after optimization" loading="lazy" style="width: 100%; height: auto; display: block;">
                </div>
                <div style="border: 1px solid var(--border); border-radius: 6px; overflow: hidden; background: #fff;">
                  <img src="/images/case-1/Portfolio Profile 1 (4).png" alt="Headline and about section positioning rewrite" loading="lazy" style="width: 100%; height: auto; display: block;">
                </div>
              </div>
            </div>
          </article>


          <!-- Case Study 2: Nick (EdTech Founder) -->
          <article class="case-study-card reveal" style="background: var(--bg); border: 2px solid var(--border); border-radius: 8px; padding: clamp(20px, 3vw, 32px); box-shadow: 4px 4px 0 var(--border);">
            <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 8px; margin-bottom: 14px; border-bottom: 1px solid var(--border); padding-bottom: 12px;">
              <div>
                <span class="tag tag-orange" style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700;">Case Study 2</span>
                <h3 style="font-size: 1.4rem; margin-top: 8px;">Nick (EdTech Founder): 3 Investor Meetings &amp; Event Invitations</h3>
              </div>
              <span style="font-size: 0.82rem; font-family: var(--font-heading); color: var(--text-muted); font-weight: 600;">July 2024</span>
            </div>

            <p style="font-size: 0.95rem; line-height: 1.6; color: var(--text); margin-bottom: 18px;">
              <strong>Strategic Scope:</strong> Built an executive founder presence from a brand-new profile with zero initial connections. Engineered high-resonance storytelling frameworks addressing core industry problems, combined with targeted outbound connection requests to corporate buyers and seed investors. Generated invitations to prominent EdTech industry events and booked 3 direct investor meetings within the initial rollout.
            </p>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 14px; margin-bottom: 24px;">
              <div style="background: var(--bg-dark); border: 1px solid var(--border); border-radius: 6px; padding: 12px 14px;">
                <div style="font-family: var(--font-heading); font-size: 1.5rem; font-weight: 800; color: var(--orange);">3 Meetings</div>
                <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 2px;">Investor Meetings Booked</div>
              </div>
              <div style="background: var(--bg-dark); border: 1px solid var(--border); border-radius: 6px; padding: 12px 14px;">
                <div style="font-family: var(--font-heading); font-size: 1.5rem; font-weight: 800; color: var(--text);">Industry Invites</div>
                <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 2px;">Invited to EdTech Events</div>
              </div>
              <div style="background: var(--bg-dark); border: 1px solid var(--border); border-radius: 6px; padding: 12px 14px;">
                <div style="font-family: var(--font-heading); font-size: 1.5rem; font-weight: 800; color: var(--text);">3,346</div>
                <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 2px;">Impressions in 28 Days</div>
              </div>
              <div style="background: var(--bg-dark); border: 1px solid var(--border); border-radius: 6px; padding: 12px 14px;">
                <div style="font-family: var(--font-heading); font-size: 1.5rem; font-weight: 800; color: var(--text);">0 Base</div>
                <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 2px;">Brand New Account</div>
              </div>
            </div>

            <!-- Visual Gallery for Case 2 -->
            <div style="margin-top: 20px;">
              <p style="font-family: var(--font-heading); font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin-bottom: 12px;">Verified Monthly Analytics Report (July 2024):</p>
              <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px;">
                <div style="border: 1px solid var(--border); border-radius: 6px; overflow: hidden; background: #fff;">
                  <img src="/images/case-2/Portfolio Profile 2 (1).png" alt="Founder LinkedIn performance report showing 3,346 impressions" loading="lazy" style="width: 100%; height: auto; display: block;">
                </div>
                <div style="border: 1px solid var(--border); border-radius: 6px; overflow: hidden; background: #fff;">
                  <img src="/images/case-2/Portfolio Profile 2 (2).png" alt="Content impression breakdown and individual post stats" loading="lazy" style="width: 100%; height: auto; display: block;">
                </div>
                <div style="border: 1px solid var(--border); border-radius: 6px; overflow: hidden; background: #fff;">
                  <img src="/images/case-2/Portfolio Profile 2 (3).png" alt="Targeted connection outreach breakdown" loading="lazy" style="width: 100%; height: auto; display: block;">
                </div>
              </div>
            </div>
          </article>

        </div>
      </div>
    </section>

    <!-- 3. BUILDS (LIVE DEMOS) -->
    <section id="builds" class="section" aria-labelledby="builds-heading">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-label">Engineering</span>
          <h2 id="builds-heading" set:html={home.buildsHeadline.replace(/\n/g, '<br>')}></h2>
          <p style="margin-top: 10px; font-size: 0.95rem; color: var(--text-muted);">
            Production digital systems built, deployed, and live on the web.
          </p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; max-width: 820px; margin: 0 auto;">
          
          <div class="reveal" style="background: var(--bg-dark); border: 2px solid var(--border); border-radius: 8px; padding: 24px; display: flex; flex-direction: column;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
              <h3 style="font-size: 1.25rem; margin: 0;">Unilimo</h3>
              <span class="tag tag-orange" style="font-size: 0.7rem;">Production Web App</span>
            </div>
            <p style="font-size: 0.9rem; line-height: 1.5; color: var(--text-light); margin-bottom: 18px; flex-grow: 1;">
              Luxury transport booking platform with dynamic airport rates and a live quote engine deployed on Vercel.
            </p>
            <div style="border-top: 1px solid var(--border); padding-top: 14px;">
              <a href="https://unilimo.vercel.app/" target="_blank" rel="noopener noreferrer" style="font-size: 0.85rem; font-weight: 700; color: var(--orange); text-decoration: underline;">
                Visit unilimo.vercel.app →
              </a>
            </div>
          </div>

          <div class="reveal" style="background: var(--bg-dark); border: 2px solid var(--border); border-radius: 8px; padding: 24px; display: flex; flex-direction: column;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
              <h3 style="font-size: 1.25rem; margin: 0;">Etimad Foundation</h3>
              <span class="tag tag-orange" style="font-size: 0.7rem;">Pro Bono Platform</span>
            </div>
            <p style="font-size: 0.9rem; line-height: 1.5; color: var(--text-light); margin-bottom: 18px; flex-grow: 1;">
              A bilingual Ramadan donation platform with integrated mobile wallet payment flows and volunteer coordination.
            </p>
            <div style="border-top: 1px solid var(--border); padding-top: 14px;">
              <a href="https://etimadfoundation.vercel.app/" target="_blank" rel="noopener noreferrer" style="font-size: 0.85rem; font-weight: 700; color: var(--orange); text-decoration: underline;">
                Visit etimadfoundation.vercel.app →
              </a>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 4. WHAT I OFFER -->
    <section id="offer" class="section" style="background: var(--bg-dark); border-top: 2px solid var(--border); border-bottom: 2px solid var(--border);" aria-labelledby="offer-heading">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-label">Pricing &amp; Scope</span>
          <h2 id="offer-heading" set:html={home.servicesHeadline.replace(/\n/g, '<br>')}></h2>
          <p style="margin-top: 10px; font-size: 0.95rem; color: var(--text-muted);">
            Straightforward commercial scope designed for sustainable pipeline growth.
          </p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; max-width: 900px; margin: 0 auto;">
          
          <!-- Offer A: Profile Rewrite -->
          <article class="reveal" style="background: var(--bg); border: 2px solid var(--border); border-radius: 8px; padding: clamp(20px, 3vw, 32px); display: flex; flex-direction: column; box-shadow: 4px 4px 0 var(--border);">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; margin-bottom: 12px;">
              <span class="tag tag-orange" style="font-size: 0.72rem;">One-Time Sprint</span>
              <div style="text-align: right;">
                <span style="font-size: 1.75rem; font-weight: 800; font-family: var(--font-heading); color: var(--orange);">$200</span>
                <span style="display: block; font-size: 0.72rem; color: var(--text-muted);">$150 with retainer</span>
              </div>
            </div>

            <h3 style="font-size: 1.35rem; margin-bottom: 10px;">LinkedIn Profile Rewrite</h3>
            <p style="font-size: 0.9rem; line-height: 1.5; color: var(--text-light); margin-bottom: 20px;">
              Reposition your personal profile into an authoritative inbound destination calibrated to convert profile visits into qualified conversations.
            </p>

            <div style="border-top: 1px solid var(--border); padding-top: 16px; margin-bottom: 24px; flex-grow: 1;">
              <p style="font-family: var(--font-heading); font-size: 0.74rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted); margin-bottom: 10px;">Deliverables:</p>
              <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; font-size: 0.88rem;">
                <li style="display: flex; gap: 8px; align-items: flex-start;">
                  <span style="color: var(--orange); font-weight: 800;">✓</span>
                  <span>Clear, value-focused headline optimized for search and conversion</span>
                </li>
                <li style="display: flex; gap: 8px; align-items: flex-start;">
                  <span style="color: var(--orange); font-weight: 800;">✓</span>
                  <span>Narrative About section highlighting domain expertise and direct CTA</span>
                </li>
                <li style="display: flex; gap: 8px; align-items: flex-start;">
                  <span style="color: var(--orange); font-weight: 800;">✓</span>
                  <span>Featured media curation and lead magnet positioning</span>
                </li>
                <li style="display: flex; gap: 8px; align-items: flex-start;">
                  <span style="color: var(--orange); font-weight: 800;">✓</span>
                  <span>Custom header banner messaging and visual direction</span>
                </li>
              </ul>
            </div>

            <a href="/book" class="btn btn-primary" style="justify-content: center; text-align: center; width: 100%;">
              Book a Profile Rewrite
            </a>
          </article>

          <!-- Offer B: Monthly Retainer -->
          <article class="reveal" style="background: var(--bg); border: 2px solid var(--orange); border-radius: 8px; padding: clamp(20px, 3vw, 32px); display: flex; flex-direction: column; box-shadow: 4px 4px 0 var(--border); position: relative;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; margin-bottom: 12px;">
              <span class="tag tag-orange" style="font-size: 0.72rem; background: var(--orange); color: #fff;">Monthly Partnership</span>
              <div style="text-align: right;">
                <span style="font-size: 1.75rem; font-weight: 800; font-family: var(--font-heading); color: var(--orange);">$600</span>
                <span style="display: block; font-size: 0.72rem; color: var(--text-muted);">per month</span>
              </div>
            </div>

            <h3 style="font-size: 1.35rem; margin-bottom: 10px;">Monthly Growth Retainer</h3>
            <p style="font-size: 0.9rem; line-height: 1.5; color: var(--text-light); margin-bottom: 14px;">
              A fully managed organic LinkedIn execution system engineered to build authority and generate 4 to 6 qualified inbound opportunities each month.
            </p>

            <div style="background: rgba(243, 111, 33, 0.08); border-left: 3px solid var(--orange); padding: 8px 12px; border-radius: 0 4px 4px 0; margin-bottom: 18px;">
              <span style="font-size: 0.84rem; font-weight: 700; color: var(--text);">Objective: 4 to 6 qualified leads &amp; strategic conversations monthly</span>
            </div>

            <div style="border-top: 1px solid var(--border); padding-top: 16px; margin-bottom: 24px; flex-grow: 1;">
              <p style="font-family: var(--font-heading); font-size: 0.74rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted); margin-bottom: 10px;">Weekly Operations (Monday to Friday):</p>
              <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; font-size: 0.88rem;">
                <li style="display: flex; gap: 8px; align-items: flex-start;">
                  <span style="color: var(--orange); font-weight: 800;">✓</span>
                  <span>1 high-impact post written and scheduled daily</span>
                </li>
                <li style="display: flex; gap: 8px; align-items: flex-start;">
                  <span style="color: var(--orange); font-weight: 800;">✓</span>
                  <span>20 to 25 value-additive comments on targeted prospect feeds daily</span>
                </li>
                <li style="display: flex; gap: 8px; align-items: flex-start;">
                  <span style="color: var(--orange); font-weight: 800;">✓</span>
                  <span>10 to 15 personalized connection requests dispatched daily</span>
                </li>
                <li style="display: flex; gap: 8px; align-items: flex-start;">
                  <span style="color: var(--orange); font-weight: 800;">✓</span>
                  <span>Weekly tracking report covering reach, pipeline progress, and key interactions</span>
                </li>
              </ul>
            </div>

            <a href="/book" class="btn btn-primary" style="justify-content: center; text-align: center; width: 100%;">
              Book a 15-Minute Call
            </a>
          </article>

        </div>
      </div>
    </section>

    <!-- 5. ABOUT ME & BIG O SOFT TESTIMONIAL -->
    <section id="about" class="section" aria-labelledby="about-heading">
      <div class="container" style="max-width: 820px;">
        <div class="section-header reveal">
          <span class="section-label">Background</span>
          <h2 id="about-heading" set:html={home.aboutHeadline.replace(/\n/g, '<br>')}></h2>
        </div>

        <div class="reveal" style="font-size: 1.05rem; line-height: 1.7; color: var(--text); display: flex; flex-direction: column; gap: 16px;">
          <p>
            I am Ahmad. I am 20 years old, completing my secondary academic milestones, and building software and organic growth systems in public.
          </p>
          <p>
            I approach content with the discipline of an engineer: clarity in thinking produces measurable leverage. Many strategists cannot build technical systems, while many developers struggle to articulate commercial positioning.
          </p>
          <p>
            I partner directly with coaches and specialized consultants to handle organic LinkedIn execution systematically so they can dedicate their focus entirely to client delivery.
          </p>
          <p>
            Every metric and case study featured here reflects verifiable historical performance.
          </p>
        </div>

        <!-- Verified Testimonial / Experience Card -->
        <div class="reveal" style="margin-top: 36px; background: var(--bg-dark); border: 2px solid var(--border); border-radius: 8px; padding: clamp(20px, 3vw, 32px); box-shadow: 4px 4px 0 var(--border);">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
            <span class="tag tag-orange" style="font-size: 0.72rem;">Verified Experience</span>
            <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: 600;">Nov 2025 – Feb 2026</span>
          </div>
          <p style="font-size: 1.02rem; line-height: 1.6; font-style: italic; color: var(--text); margin-bottom: 16px;">
            "Ahmad worked with Big O Soft as a Content Strategist. He brought exceptional work ethic, structured storytelling, and clear execution to our growth systems."
          </p>
          <div style="display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--border); padding-top: 12px;">
            <div>
              <span style="font-weight: 700; font-family: var(--font-heading); display: block;">Big O Soft</span>
              <span style="font-size: 0.82rem; color: var(--text-muted);">Verified Experience Letter on File</span>
            </div>
            <span style="color: var(--orange); font-size: 0.85rem; font-weight: 700;">Content Strategist</span>
          </div>
        </div>

      </div>
    </section>

    <!-- 6. FINAL CALL TO ACTION -->
    <CTABand heading={home.ctaHeadline} subtext={home.ctaSubtext} btnText="Book a 15-minute call" btnHref="/book" />

  </main>

  <Footer />
</BaseLayout>
