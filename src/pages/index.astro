---
import BaseLayout from '../layouts/BaseLayout.astro';
import frameworks from '../data/frameworks.json';

const hasFrameworks = Array.isArray(frameworks) && frameworks.length > 0;
---

<BaseLayout
  title="Ahmad Farooq | GTM, Operations and Product"
  description="GTM, operations and product for founders who ship. Launch strategy, growth systems, and sites I build myself."
>
  <!-- Hero Section -->
  <section class="hero-section" aria-labelledby="hero-heading">
    <div class="site-container">
      <div class="hero-content reveal-on-scroll">
        <h1 id="hero-heading" class="hero-heading">
          GTM, operations and product for founders who ship.
        </h1>
        <p class="hero-subline">
          Launch strategy, growth systems, and sites I build myself.
        </p>
        <div class="hero-actions">
          <a href="#work" class="btn btn-primary">See the work</a>
          <a href="mailto:byahmadfarooq@gmail.com" class="btn btn-secondary">Message me</a>
        </div>
      </div>
    </div>
  </section>

  <!-- What I Do (Three Columns) -->
  <section id="what-i-do" class="section" aria-labelledby="what-i-do-heading">
    <div class="site-container">
      <header class="section-header reveal-on-scroll">
        <span class="section-tag">Focus</span>
        <h2 id="what-i-do-heading" class="visually-hidden" style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); border: 0;">What I do</h2>
      </header>
      <div class="what-i-do-grid">
        <article class="pillar-column reveal-on-scroll">
          <div class="pillar-num" aria-hidden="true">01</div>
          <h3 class="pillar-title">Go-to-market</h3>
          <p class="pillar-desc">
            Positioning, launch strategy and funnels for software products. Who it is for, what to say, and where the first customers come from.
          </p>
        </article>

        <article class="pillar-column reveal-on-scroll">
          <div class="pillar-num" aria-hidden="true">02</div>
          <h3 class="pillar-title">Operations and systems</h3>
          <p class="pillar-desc">
            The processes and tooling that keep a launch running after the first week.
          </p>
        </article>

        <article class="pillar-column reveal-on-scroll">
          <div class="pillar-num" aria-hidden="true">03</div>
          <h3 class="pillar-title">Product</h3>
          <p class="pillar-desc">
            How to make a product better by looking at how people actually use it.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- Selected Work (Two Cards) -->
  <section id="work" class="section" aria-labelledby="work-heading">
    <div class="site-container">
      <header class="section-header reveal-on-scroll">
        <span class="section-tag">Showcase</span>
        <h2 id="work-heading">Selected work</h2>
      </header>
      <div class="work-grid">
        <!-- Unilimo Card -->
        <article class="work-card reveal-on-scroll">
          <a href="https://unilimo.vercel.app/" target="_blank" rel="noopener noreferrer" style="text-decoration:none; color:inherit; display:flex; flex-direction:column; height:100%;">
            <div class="work-media">
              <picture>
                <source type="image/avif" srcset="/images/work/unilimo-640.avif 640w, /images/work/unilimo-960.avif 960w, /images/work/unilimo-1280.avif 1280w" sizes="(max-width: 840px) 100vw, 540px" />
                <source type="image/webp" srcset="/images/work/unilimo-640.webp 640w, /images/work/unilimo-960.webp 960w, /images/work/unilimo-1280.webp 1280w" sizes="(max-width: 840px) 100vw, 540px" />
                <img
                  src="/images/work/unilimo-960.webp"
                  alt="Screenshot of the Unilimo booking platform and live quote engine"
                  width="1280"
                  height="800"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </div>
            <div class="work-details">
              <div class="work-title-wrap">
                <h3 class="work-title">Unilimo</h3>
                <span class="work-arrow" aria-hidden="true">Live site &rarr;</span>
              </div>
              <p class="work-desc">
                A booking platform with a live quote engine. My role: built and launched it.
              </p>
            </div>
          </a>
        </article>

        <!-- Etimad Foundation Card -->
        <article class="work-card reveal-on-scroll">
          <a href="https://etimadfoundation.vercel.app/" target="_blank" rel="noopener noreferrer" style="text-decoration:none; color:inherit; display:flex; flex-direction:column; height:100%;">
            <div class="work-media">
              <picture>
                <source type="image/avif" srcset="/images/work/etimad-640.avif 640w, /images/work/etimad-960.avif 960w, /images/work/etimad-1280.avif 1280w" sizes="(max-width: 840px) 100vw, 540px" />
                <source type="image/webp" srcset="/images/work/etimad-640.webp 640w, /images/work/etimad-960.webp 960w, /images/work/etimad-1280.webp 1280w" sizes="(max-width: 840px) 100vw, 540px" />
                <img
                  src="/images/work/etimad-960.webp"
                  alt="Screenshot of the Etimad Foundation website"
                  width="1280"
                  height="800"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </div>
            <div class="work-details">
              <div class="work-title-wrap">
                <h3 class="work-title">Etimad Foundation</h3>
                <span class="work-arrow" aria-hidden="true">Live site &rarr;</span>
              </div>
              <p class="work-desc">
                The foundation’s website. My role: built it.
              </p>
            </div>
          </a>
        </article>
      </div>
    </div>
  </section>

  <!-- Decision Frameworks (Hidden when frameworks.json is empty) -->
  {hasFrameworks && (
    <section id="frameworks" class="section" aria-labelledby="frameworks-heading">
      <div class="site-container">
        <header class="section-header reveal-on-scroll">
          <span class="section-tag">Playbook</span>
          <h2 id="frameworks-heading">Decision frameworks</h2>
        </header>
        <div class="frameworks-grid">
          {frameworks.map((item) => (
            <article class="framework-card reveal-on-scroll">
              <div class="framework-image-wrap">
                {item.image && (
                  <img
                    src={item.image}
                    alt={item.title || "Decision framework screenshot"}
                    loading="lazy"
                    decoding="async"
                  />
                )}
                {item.clientLabel && (
                  <span class="framework-client-label">{item.clientLabel}</span>
                )}
                {item.decisionOverImage && (
                  <div class="framework-overlay-decision">{item.decisionOverImage}</div>
                )}
              </div>
              <div class="framework-field">
                <span class="framework-label">Decision: </span>
                <span>{item.decision}</span>
              </div>
              <div class="framework-field">
                <span class="framework-label">Why: </span>
                <span>{item.why}</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Background Section -->
  <section id="background" class="section" aria-labelledby="background-heading">
    <div class="site-container">
      <header class="section-header reveal-on-scroll">
        <span class="section-tag">Record</span>
        <h2 id="background-heading">Background</h2>
      </header>
      <div class="background-card reveal-on-scroll">
        <p class="background-text">
          Content strategist at Big O Soft, November 2025 to February 2026. Content strategy and funnel work for newsletters and brands.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="section" aria-labelledby="contact-heading" style="border-bottom:none;">
    <div class="site-container">
      <header class="section-header reveal-on-scroll">
        <span class="section-tag">Conversation</span>
        <h2 id="contact-heading" class="visually-hidden" style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); border: 0;">Contact</h2>
      </header>
      <div class="contact-content reveal-on-scroll">
        <p class="contact-statement">
          If you are launching something and want a second pair of eyes, message me.
        </p>
        <ul class="contact-links" role="list">
          <li>
            <a
              href="https://www.linkedin.com/in/byahmad/"
              target="_blank"
              rel="noopener noreferrer"
              class="contact-link"
              aria-label="LinkedIn profile"
            >
              LinkedIn
            </a>
          </li>
          <li>
            <a
              href="mailto:byahmadfarooq@gmail.com"
              class="contact-link"
              aria-label="Send email to byahmadfarooq@gmail.com"
            >
              Email
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
