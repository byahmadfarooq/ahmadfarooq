---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTABand from '../components/CTABand.astro';
import ClientsGrid from '../components/ClientsGrid.astro';
import home from '../content/pages/home.json';
---

<BaseLayout
  title="Ahmad Farooq | LinkedIn Growth for Coaches & Consultants"
  description="I help coaches and solo consultants get clients from LinkedIn with daily posts, targeted comments, and profile rewrites."
  canonicalPath="/"
>
  <Header />

  <main>

    <!-- 1. HERO -->
    <section aria-label="Introduction" class="section" style="padding-top: 60px; padding-bottom: 50px;">
      <div class="hero-wrap">
        <div class="hero-content">
          <span class="hero-label">{home.heroLabel}</span>
          <h1 class="hero-title" style="font-size: clamp(2rem, 4vw, 2.85rem); line-height: 1.18; margin: 12px 0 16px 0;">{home.heroTitle}</h1>
          <p class="hero-tagline" style="font-size: 1.05rem; line-height: 1.6; max-width: 580px; margin-bottom: 28px;">{home.heroTagline}</p>

          <div class="hero-actions" style="margin-bottom: 0;">
            <a href="/book" class="btn btn-primary">{home.heroCTA1Text}</a>
          </div>
        </div>

        <div class="hero-visual">
          <div class="profile-frame">
            <img src="/images/ahmad-profile.png" alt="Ahmad Farooq, LinkedIn Growth Specialist and Builder" width="340" height="440" loading="eager">
          </div>
        </div>
      </div>
    </section>

    <!-- WORKED WITH -->
    <ClientsGrid />

    <!-- 2. PROOF (CASE STUDIES) -->
    <section id="work" class="section" style="background: var(--bg-dark); border-top: 2px solid var(--border); border-bottom: 2px solid var(--border);" aria-labelledby="cases-heading">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-label">Case Studies</span>
          <h2 id="cases-heading" set:html={home.casesHeadline.replace(/\n/g, '<br>')}></h2>
          <p style="margin-top: 10px; font-size: 0.95rem; color: var(--text-muted);">
            Every number here comes from verified client analytics. No inflated vanity metrics.
          </p>
        </div>

        <div class="case-studies-list" style="display: flex; flex-direction: column; gap: 40px;">
          
          <!-- Case Study 1: Wellness Coach -->
          <article class="case-study-card reveal" style="background: var(--bg); border: 2px solid var(--border); border-radius: 8px; padding: clamp(20px, 3vw, 36px); box-shadow: 4px 4px 0 var(--border);">
            <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 8px; margin-bottom: 14px; border-bottom: 1px solid var(--border); padding-bottom: 12px;">
              <div>
                <span class="tag tag-orange" style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700;">Case Study 1</span>
                <h3 style="font-size: 1.4rem; margin-top: 8px;">Wellness Coach: 101,050 Impressions in 90 Days</h3>
              </div>
              <span style="font-size: 0.82rem; font-family: var(--font-heading); color: var(--text-muted); font-weight: 600;">May to August 2024</span>
            </div>

            <p style="font-size: 0.95rem; line-height: 1.6; color: var(--text); margin-bottom: 18px;">
              <strong>What I did:</strong> Wrote a complete before/after profile rewrite. Ran a done-for-you system Monday to Friday with 1 daily post, 20 to 25 niche comments, and 10 to 15 targeted connection requests.
            </p>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 14px; margin-bottom: 24px;">
              <div style="background: var(--bg-dark); border: 1px solid var(--border); border-radius: 6px; padding: 12px 14px;">
                <div style="font-family: var(--font-heading); font-size: 1.5rem; font-weight: 800; color: var(--orange);">101,050</div>
                <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 2px;">Impressions (90 Days)</div>
              </div>
              <div style="background: var(--bg-dark); border: 1px solid var(--border); border-radius: 6px; padding: 12px 14px;">
                <div style="font-family: var(--font-heading); font-size: 1.5rem; font-weight: 800; color: var(--text);">90 Days</div>
                <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 2px;">May to Aug 2024</div>
              </div>
              <div style="background: var(--bg-dark); border: 1px solid var(--border); border-radius: 6px; padding: 12px 14px;">
                <div style="font-family: var(--font-heading); font-size: 1.5rem; font-weight: 800; color: var(--text);">Done-for-you</div>
                <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 2px;">Mon–Fri Daily System</div>
              </div>
            </div>

            <!-- Visual Gallery for Case 1 -->
            <div style="margin-top: 20px;">
              <p style="font-family: var(--font-heading); font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin-bottom: 12px;">Verified Proof &amp; Profile Rewrites (Client Anonymised):</p>
              <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px;">
                <div style="border: 1px solid var(--border); border-radius: 6px; overflow: hidden; background: #fff;">
                  <img src="/images/case-1/Portfolio Profile 1 (1).png" alt="Wellness coach LinkedIn 90-day impressions analytics showing 101,050 impressions" loading="lazy" style="width: 100%; height: auto; display: block;">
                </div>
                <div style="border: 1px solid var(--border); border-radius: 6px; overflow: hidden; background: #fff;">
                  <img src="/images/case-1/Portfolio Profile 1 (2).png" alt="Wellness coach LinkedIn impressions and audience engagement chart" loading="lazy" style="width: 100%; height: auto; display: block;">
                </div>
                <div style="border: 1px solid var(--border); border-radius: 6px; overflow: hidden; background: #fff;">
                  <img src="/images/case-1/Portfolio Profile 1 (3).png" alt="LinkedIn profile rewrite before and after slide 1" loading="lazy" style="width: 100%; height: auto; display: block;">
                </div>
                <div style="border: 1px solid var(--border); border-radius: 6px; overflow: hidden; background: #fff;">
                  <img src="/images/case-1/Portfolio Profile 1 (4).png" alt="LinkedIn profile rewrite before and after slide 2" loading="lazy" style="width: 100%; height: auto; display: block;">
                </div>
              </div>
            </div>

            <div style="margin-top: 20px; padding: 12px 16px; background: rgba(0,0,0,0.03); border-left: 3px solid var(--orange); border-radius: 0 4px 4px 0; font-size: 0.85rem; color: var(--text-muted);">
              <em>Client note: Testimonial placeholder pending signed permission. Client identity anonymised to respect privacy.</em>
            </div>
          </article>


          <!-- Case Study 2: EdTech / SaaS Founder -->
          <article class="case-study-card reveal" style="background: var(--bg); border: 2px solid var(--border); border-radius: 8px; padding: clamp(20px, 3vw, 36px); box-shadow: 4px 4px 0 var(--border);">
            <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 8px; margin-bottom: 14px; border-bottom: 1px solid var(--border); padding-bottom: 12px;">
              <div>
                <span class="tag tag-orange" style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700;">Case Study 2</span>
                <h3 style="font-size: 1.4rem; margin-top: 8px;">EdTech / SaaS Founder: 0 Followers to 3,346 Impressions in 28 Days</h3>
              </div>
              <span style="font-size: 0.82rem; font-family: var(--font-heading); color: var(--text-muted); font-weight: 600;">July 2024</span>
            </div>

            <p style="font-size: 0.95rem; line-height: 1.6; color: var(--text); margin-bottom: 18px;">
              <strong>What I did:</strong> Built a brand new profile from zero followers. Created pain-point storytelling posts and targeted connection requests Monday to Friday. State honestly: this was a small starting base, reaching 3,346 impressions in 28 days with top posts between 583 and 728 impressions.
            </p>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 14px; margin-bottom: 24px;">
              <div style="background: var(--bg-dark); border: 1px solid var(--border); border-radius: 6px; padding: 12px 14px;">
                <div style="font-family: var(--font-heading); font-size: 1.5rem; font-weight: 800; color: var(--orange);">3,346</div>
                <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 2px;">Impressions (28 Days)</div>
              </div>
              <div style="background: var(--bg-dark); border: 1px solid var(--border); border-radius: 6px; padding: 12px 14px;">
                <div style="font-family: var(--font-heading); font-size: 1.5rem; font-weight: 800; color: var(--text);">0 to Start</div>
                <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 2px;">Brand New Profile</div>
              </div>
              <div style="background: var(--bg-dark); border: 1px solid var(--border); border-radius: 6px; padding: 12px 14px;">
                <div style="font-family: var(--font-heading); font-size: 1.5rem; font-weight: 800; color: var(--text);">583–728</div>
                <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 2px;">Top Post Impressions</div>
              </div>
            </div>

            <!-- Visual Gallery for Case 2 -->
            <div style="margin-top: 20px;">
              <p style="font-family: var(--font-heading); font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin-bottom: 12px;">Verified Analytics Screenshot (July 2024 Report):</p>
              <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px;">
                <div style="border: 1px solid var(--border); border-radius: 6px; overflow: hidden; background: #fff;">
                  <img src="/images/case-2/Portfolio Profile 2 (1).png" alt="EdTech founder LinkedIn analytics overview showing 3,346 impressions" loading="lazy" style="width: 100%; height: auto; display: block;">
                </div>
                <div style="border: 1px solid var(--border); border-radius: 6px; overflow: hidden; background: #fff;">
                  <img src="/images/case-2/Portfolio Profile 2 (2).png" alt="Post performance breakdown and impressions chart" loading="lazy" style="width: 100%; height: auto; display: block;">
                </div>
                <div style="border: 1px solid var(--border); border-radius: 6px; overflow: hidden; background: #fff;">
                  <img src="/images/case-2/Portfolio Profile 2 (3).png" alt="Targeted connection requests and engagement stats" loading="lazy" style="width: 100%; height: auto; display: block;">
                </div>
              </div>
            </div>

            <div style="margin-top: 20px; padding: 12px 16px; background: rgba(0,0,0,0.03); border-left: 3px solid var(--orange); border-radius: 0 4px 4px 0; font-size: 0.85rem; color: var(--text-muted);">
              <em>Client note: Testimonial placeholder pending signed permission. Client identity anonymised to respect privacy.</em>
            </div>
          </article>

        </div>
      </div>
    </section>

    <!-- 3. BUILDS (LIVE DEMOS) -->
    <section id="builds" class="section" aria-labelledby="builds-heading">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-label">Engineering</span>
          <h2 id="builds-heading" set:html={home.buildsHeadline.replace(/\n/g, '<br>')}></h2>
          <p style="margin-top: 10px; font-size: 0.95rem; color: var(--text-muted);">
            I am a builder who writes. Here are three live projects I built that you can inspect right now.
          </p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px;">
          
          <div class="reveal" style="background: var(--bg-dark); border: 2px solid var(--border); border-radius: 8px; padding: 24px; display: flex; flex-direction: column;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
              <h3 style="font-size: 1.25rem; margin: 0;">ARKA</h3>
              <span class="tag tag-orange" style="font-size: 0.7rem;">SaaS App</span>
            </div>
            <p style="font-size: 0.9rem; line-height: 1.5; color: var(--text-light); margin-bottom: 18px; flex-grow: 1;">
              A full brand command center for creators and operators with live database tracking, pipeline boards, and analytics.
            </p>
            <div style="border-top: 1px solid var(--border); padding-top: 14px;">
              <span style="font-size: 0.85rem; font-weight: 700; color: var(--orange);">Available for live walkthrough</span>
            </div>
          </div>

          <div class="reveal" style="background: var(--bg-dark); border: 2px solid var(--border); border-radius: 8px; padding: 24px; display: flex; flex-direction: column;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
              <h3 style="font-size: 1.25rem; margin: 0;">Unilimo</h3>
              <span class="tag tag-orange" style="font-size: 0.7rem;">Live Web App</span>
            </div>
            <p style="font-size: 0.9rem; line-height: 1.5; color: var(--text-light); margin-bottom: 18px; flex-grow: 1;">
              Luxury transport booking platform with dynamic airport rates and a live quote engine deployed on Vercel.
            </p>
            <div style="border-top: 1px solid var(--border); padding-top: 14px;">
              <a href="https://unilimo.vercel.app/" target="_blank" rel="noopener noreferrer" style="font-size: 0.85rem; font-weight: 700; color: var(--orange); text-decoration: underline;">
                Visit unilimo.vercel.app →
              </a>
            </div>
          </div>

          <div class="reveal" style="background: var(--bg-dark); border: 2px solid var(--border); border-radius: 8px; padding: 24px; display: flex; flex-direction: column;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
              <h3 style="font-size: 1.25rem; margin: 0;">Etimad Foundation</h3>
              <span class="tag tag-orange" style="font-size: 0.7rem;">Pro Bono NGO</span>
            </div>
            <p style="font-size: 0.9rem; line-height: 1.5; color: var(--text-light); margin-bottom: 18px; flex-grow: 1;">
              A bilingual Ramadan donation platform with mobile wallet payment flow and volunteer registration.
            </p>
            <div style="border-top: 1px solid var(--border); padding-top: 14px;">
              <span style="font-size: 0.85rem; font-weight: 700; color: var(--orange);">Built pro bono for the community</span>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 4. WHAT I OFFER -->
    <section id="offer" class="section" style="background: var(--bg-dark); border-top: 2px solid var(--border); border-bottom: 2px solid var(--border);" aria-labelledby="offer-heading">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-label">Pricing &amp; Scope</span>
          <h2 id="offer-heading" set:html={home.servicesHeadline.replace(/\n/g, '<br>')}></h2>
          <p style="margin-top: 10px; font-size: 0.95rem; color: var(--text-muted);">
            Simple terms. Clear deliverables. No lock-in contracts.
          </p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; max-width: 900px; margin: 0 auto;">
          
          <!-- Offer A: Profile Rewrite -->
          <article class="reveal" style="background: var(--bg); border: 2px solid var(--border); border-radius: 8px; padding: clamp(20px, 3vw, 32px); display: flex; flex-direction: column; box-shadow: 4px 4px 0 var(--border);">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; margin-bottom: 12px;">
              <span class="tag tag-orange" style="font-size: 0.72rem;">One-Time Sprint</span>
              <div style="text-align: right;">
                <span style="font-size: 1.75rem; font-weight: 800; font-family: var(--font-heading); color: var(--orange);">$200</span>
                <span style="display: block; font-size: 0.72rem; color: var(--text-muted);">$150 with retainer</span>
              </div>
            </div>

            <h3 style="font-size: 1.35rem; margin-bottom: 10px;">LinkedIn Profile Rewrite</h3>
            <p style="font-size: 0.9rem; line-height: 1.5; color: var(--text-light); margin-bottom: 20px;">
              Turn your personal profile into a high-converting landing page that positions you as the clear authority in your niche.
            </p>

            <div style="border-top: 1px solid var(--border); padding-top: 16px; margin-bottom: 24px; flex-grow: 1;">
              <p style="font-family: var(--font-heading); font-size: 0.74rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted); margin-bottom: 10px;">What is included:</p>
              <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; font-size: 0.88rem;">
                <li style="display: flex; gap: 8px; align-items: flex-start;">
                  <span style="color: var(--orange); font-weight: 800;">✓</span>
                  <span>Clear, benefit-driven headline (no corporate jargon)</span>
                </li>
                <li style="display: flex; gap: 8px; align-items: flex-start;">
                  <span style="color: var(--orange); font-weight: 800;">✓</span>
                  <span>Story-driven About section with a clear call to action</span>
                </li>
                <li style="display: flex; gap: 8px; align-items: flex-start;">
                  <span style="color: var(--orange); font-weight: 800;">✓</span>
                  <span>Featured section structure and lead magnet placement</span>
                </li>
                <li style="display: flex; gap: 8px; align-items: flex-start;">
                  <span style="color: var(--orange); font-weight: 800;">✓</span>
                  <span>Header banner copy and direction</span>
                </li>
              </ul>
            </div>

            <a href="/book" class="btn btn-primary" style="justify-content: center; text-align: center; width: 100%;">
              Book a Profile Rewrite
            </a>
          </article>

          <!-- Offer B: Monthly Retainer -->
          <article class="reveal" style="background: var(--bg); border: 2px solid var(--orange); border-radius: 8px; padding: clamp(20px, 3vw, 32px); display: flex; flex-direction: column; box-shadow: 4px 4px 0 var(--border); position: relative;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; margin-bottom: 12px;">
              <span class="tag tag-orange" style="font-size: 0.72rem; background: var(--orange); color: #fff;">Monthly Partnership</span>
              <div style="text-align: right;">
                <span style="font-size: 1.75rem; font-weight: 800; font-family: var(--font-heading); color: var(--orange);">$600</span>
                <span style="display: block; font-size: 0.72rem; color: var(--text-muted);">per month</span>
              </div>
            </div>

            <h3 style="font-size: 1.35rem; margin-bottom: 10px;">Monthly Growth Retainer</h3>
            <p style="font-size: 0.9rem; line-height: 1.5; color: var(--text-light); margin-bottom: 20px;">
              A complete done-for-you organic system so you never have to worry about what to post or who to reach out to.
            </p>

            <div style="border-top: 1px solid var(--border); padding-top: 16px; margin-bottom: 24px; flex-grow: 1;">
              <p style="font-family: var(--font-heading); font-size: 0.74rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted); margin-bottom: 10px;">What is included (Monday to Friday):</p>
              <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; font-size: 0.88rem;">
                <li style="display: flex; gap: 8px; align-items: flex-start;">
                  <span style="color: var(--orange); font-weight: 800;">✓</span>
                  <span>1 high-signal post written and published daily (Mon–Fri)</span>
                </li>
                <li style="display: flex; gap: 8px; align-items: flex-start;">
                  <span style="color: var(--orange); font-weight: 800;">✓</span>
                  <span>20 to 25 thoughtful comments on prospect &amp; peer posts daily</span>
                </li>
                <li style="display: flex; gap: 8px; align-items: flex-start;">
                  <span style="color: var(--orange); font-weight: 800;">✓</span>
                  <span>10 to 15 targeted connection requests sent daily</span>
                </li>
                <li style="display: flex; gap: 8px; align-items: flex-start;">
                  <span style="color: var(--orange); font-weight: 800;">✓</span>
                  <span>Weekly report tracking views, connections, and responses</span>
                </li>
              </ul>
            </div>

            <a href="/book" class="btn btn-primary" style="justify-content: center; text-align: center; width: 100%;">
              Book a 15-Minute Call
            </a>
          </article>

        </div>
      </div>
    </section>

    <!-- 5. ABOUT ME & BIG O SOFT TESTIMONIAL -->
    <section id="about" class="section" aria-labelledby="about-heading">
      <div class="container" style="max-width: 820px;">
        <div class="section-header reveal">
          <span class="section-label">Background</span>
          <h2 id="about-heading" set:html={home.aboutHeadline.replace(/\n/g, '<br>')}></h2>
        </div>

        <div class="reveal" style="font-size: 1.05rem; line-height: 1.7; color: var(--text); display: flex; flex-direction: column; gap: 16px;">
          <p>
            I am Ahmad. I am 20 years old, finishing my GED, and building software and content systems in public.
          </p>
          <p>
            I write because clear thinking creates leverage. Most people either write without understanding how software works, or build tools without knowing how to communicate.
          </p>
          <p>
            I work directly with coaches and solo consultants. My job is to take the pressure of daily LinkedIn writing off your shoulders so you can focus on working with your clients.
          </p>
          <p>
            Every claim on this page is backed by real work and verifiable records. If you want honest execution without agency bloat, let us talk.
          </p>
        </div>

        <!-- Verified Testimonial / Experience Card -->
        <div class="reveal" style="margin-top: 36px; background: var(--bg-dark); border: 2px solid var(--border); border-radius: 8px; padding: clamp(20px, 3vw, 32px); box-shadow: 4px 4px 0 var(--border);">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
            <span class="tag tag-orange" style="font-size: 0.72rem;">Verified Experience</span>
            <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: 600;">Nov 2025 – Feb 2026</span>
          </div>
          <p style="font-size: 1.02rem; line-height: 1.6; font-style: italic; color: var(--text); margin-bottom: 16px;">
            "Ahmad worked with Big O Soft as a Content Strategist. He brought exceptional work ethic, structured storytelling, and clear execution to our growth systems."
          </p>
          <div style="display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--border); padding-top: 12px;">
            <div>
              <span style="font-weight: 700; font-family: var(--font-heading); display: block;">Big O Soft</span>
              <span style="font-size: 0.82rem; color: var(--text-muted);">Verified Experience Letter on File</span>
            </div>
            <span style="color: var(--orange); font-size: 0.85rem; font-weight: 700;">Content Strategist</span>
          </div>
        </div>

      </div>
    </section>

    <!-- 6. FINAL CALL TO ACTION -->
    <CTABand heading={home.ctaHeadline} subtext={home.ctaSubtext} btnText="Book a 15-minute call" btnHref="/book" />

  </main>

  <Footer />
</BaseLayout>
