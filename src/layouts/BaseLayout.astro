---
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = "Ahmad Farooq | GTM, Operations and Product",
  description = "GTM, operations and product for founders who ship. Launch strategy, growth systems, and sites I build myself.",
  noindex = false,
} = Astro.props;

const siteUrl = "https://ahmadfarooq.vercel.app";
const canonicalURL = new URL(Astro.url.pathname, siteUrl).href;
const ogImageURL = `${siteUrl}/images/og-image.png`;

import frameworks from '../data/frameworks.json';
const hasFrameworks = Array.isArray(frameworks) && frameworks.length > 0;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow" />
    )}

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Preload Self-Hosted WOFF2 Fonts -->
    <link rel="preload" href="/fonts/newsreader-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Ahmad Farooq" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- JSON-LD Person Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Ahmad Farooq",
      "url": "https://ahmadfarooq.vercel.app",
      "jobTitle": "Go-to-market, Operations and Product",
      "description": "GTM, operations and product for founders who ship. Launch strategy, growth systems, and sites I build myself.",
      "email": "mailto:byahmadfarooq@gmail.com",
      "sameAs": [
        "https://www.linkedin.com/in/byahmad/"
      ]
    })} />

    <!-- Inline Critical CSS -->
    <style is:inline>
      /* Self-Hosted Fonts */
      @font-face {
        font-family: 'Newsreader';
        font-style: normal;
        font-weight: 400 600;
        font-display: swap;
        src: url('/fonts/newsreader-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Newsreader';
        font-style: italic;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/newsreader-italic-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 400 600;
        font-display: swap;
        src: url('/fonts/inter-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }

      /* CSS Variables */
      :root {
        --color-bg: #F4EFE6;
        --color-bg-card: #FAF7F2;
        --color-text: #1A1A1A;
        --color-text-muted: #4A4A4A;
        --color-text-faint: #6A6660;
        --color-accent: #E4572E;
        --color-accent-hover: #C53E17;
        --color-border: #E0D7C7;
        --color-border-dark: #1A1A1A;
        --color-grid: rgba(26, 26, 26, 0.035);

        --font-serif: 'Newsreader', Georgia, serif;
        --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;

        --font-size-xs: clamp(0.75rem, 0.72rem + 0.15vw, 0.8125rem);
        --font-size-sm: clamp(0.875rem, 0.84rem + 0.18vw, 0.9375rem);
        --font-size-body: clamp(1rem, 0.96rem + 0.2vw, 1.0625rem); /* At least 16px */
        --font-size-lead: clamp(1.125rem, 1.05rem + 0.35vw, 1.25rem);
        --font-size-h3: clamp(1.25rem, 1.15rem + 0.5vw, 1.5rem);
        --font-size-h2: clamp(1.75rem, 1.5rem + 1vw, 2.375rem);
        --font-size-hero: clamp(2.35rem, 1.8rem + 2.5vw, 4rem);

        --space-1: 0.25rem;
        --space-2: 0.5rem;
        --space-3: 0.75rem;
        --space-4: 1rem;
        --space-6: 1.5rem;
        --space-8: 2rem;
        --space-12: 3rem;
        --space-16: 4rem;
        --space-20: 5rem;
        --space-24: 6rem;

        --container-width: 1080px;
        --container-padding: clamp(1.25rem, 1rem + 1.5vw, 2.5rem);
      }

      /* Reset & Box Sizing */
      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        font-family: var(--font-sans);
        font-size: 16px;
        line-height: 1.55;
        color: var(--color-text);
        background-color: var(--color-bg);
        background-image: 
          linear-gradient(to right, var(--color-grid) 1px, transparent 1px),
          linear-gradient(to bottom, var(--color-grid) 1px, transparent 1px);
        background-size: 36px 36px;
        scroll-behavior: smooth;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
      }

      body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        color: var(--color-text);
        overflow-x: hidden;
      }

      /* Skip Link */
      .skip-link {
        position: absolute;
        top: -100px;
        left: var(--space-4);
        background: var(--color-text);
        color: #FFFFFF;
        padding: var(--space-3) var(--space-4);
        font-size: var(--font-size-sm);
        font-weight: 500;
        text-decoration: none;
        z-index: 9999;
        border-radius: 2px;
      }
      .skip-link:focus {
        top: var(--space-4);
        outline: 2px solid var(--color-accent);
      }

      /* Container */
      .site-container {
        width: 100%;
        max-width: var(--container-width);
        margin-left: auto;
        margin-right: auto;
        padding-left: var(--container-padding);
        padding-right: var(--container-padding);
      }

      /* Focus states */
      a:focus-visible, button:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 3px;
      }

      /* Header */
      .site-header {
        border-bottom: 1px solid var(--color-border);
        padding-top: var(--space-6);
        padding-bottom: var(--space-6);
      }
      .header-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: var(--space-4);
      }
      .site-brand {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        font-family: var(--font-sans);
        font-size: var(--font-size-body);
        font-weight: 600;
        color: var(--color-text);
        text-decoration: none;
        letter-spacing: -0.01em;
      }
      .site-brand:hover {
        color: var(--color-accent);
      }
      .site-brand-dot {
        width: 7px;
        height: 7px;
        background-color: var(--color-accent);
        border-radius: 50%;
        display: inline-block;
      }

      .site-nav ul {
        display: flex;
        list-style: none;
        gap: clamp(1rem, 0.8rem + 1vw, 2rem);
        align-items: center;
      }
      .site-nav a {
        font-size: var(--font-size-sm);
        font-weight: 500;
        color: var(--color-text-muted);
        text-decoration: none;
        padding: var(--space-2) 0;
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        transition: color 0.15s ease;
      }
      .site-nav a:hover {
        color: var(--color-accent);
      }

      /* Main Content Layout */
      main {
        flex: 1;
      }

      /* Typography */
      h1, h2, h3 {
        font-family: var(--font-serif);
        font-weight: 500;
        color: var(--color-text);
        line-height: 1.15;
        letter-spacing: -0.02em;
        text-align: left;
      }
      p {
        font-size: var(--font-size-body);
        color: var(--color-text-muted);
        line-height: 1.6;
        text-align: left;
      }

      /* Editorial Rhythm Sections */
      .section {
        padding-top: var(--space-16);
        padding-bottom: var(--space-16);
        border-bottom: 1px solid var(--color-border);
      }
      .section-header {
        margin-bottom: var(--space-8);
      }
      .section-tag {
        font-family: var(--font-sans);
        font-size: var(--font-size-xs);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--color-accent);
        display: block;
        margin-bottom: var(--space-2);
      }

      /* Hero Section */
      .hero-section {
        padding-top: clamp(3rem, 2.5rem + 3vw, 5.5rem);
        padding-bottom: clamp(3rem, 2.5rem + 3vw, 5.5rem);
        border-bottom: 1px solid var(--color-border);
      }
      .hero-content {
        max-width: 820px;
        text-align: left;
      }
      .hero-heading {
        font-size: var(--font-size-hero);
        font-weight: 500;
        color: var(--color-text);
        line-height: 1.08;
        margin-bottom: var(--space-6);
        letter-spacing: -0.025em;
      }
      .hero-subline {
        font-family: var(--font-sans);
        font-size: var(--font-size-lead);
        color: var(--color-text-muted);
        line-height: 1.5;
        margin-bottom: var(--space-8);
        max-width: 600px;
      }
      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-4);
        align-items: center;
      }

      /* Buttons */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px; /* Tap target >= 44px */
        padding: 0.75rem 1.6rem;
        font-family: var(--font-sans);
        font-size: var(--font-size-sm);
        font-weight: 600;
        text-decoration: none;
        border-radius: 2px;
        cursor: pointer;
        transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
      }
      .btn-primary {
        background-color: var(--color-accent);
        color: #FFFFFF;
        border: 1px solid var(--color-accent);
      }
      .btn-primary:hover {
        background-color: var(--color-accent-hover);
        border-color: var(--color-accent-hover);
      }
      .btn-secondary {
        background-color: transparent;
        color: var(--color-text);
        border: 1px solid var(--color-border-dark);
      }
      .btn-secondary:hover {
        background-color: var(--color-text);
        color: #FFFFFF;
      }

      /* What I Do (Three Columns) */
      .what-i-do-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: clamp(1.5rem, 1rem + 1.5vw, 3rem);
      }
      .pillar-column {
        border-top: 2px solid var(--color-border-dark);
        padding-top: var(--space-4);
        text-align: left;
      }
      .pillar-num {
        font-family: var(--font-sans);
        font-size: var(--font-size-xs);
        font-weight: 600;
        color: var(--color-accent);
        margin-bottom: var(--space-3);
      }
      .pillar-title {
        font-size: var(--font-size-h3);
        margin-bottom: var(--space-3);
        color: var(--color-text);
      }
      .pillar-desc {
        font-size: var(--font-size-body);
        color: var(--color-text-muted);
        line-height: 1.55;
      }

      /* Selected Work (Two Cards) */
      .work-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: clamp(1.5rem, 1rem + 2vw, 3rem);
      }
      .work-card {
        background: var(--color-bg-card);
        border: 1px solid var(--color-border);
        border-radius: 2px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        text-decoration: none;
        color: inherit;
        transition: border-color 0.2s ease, transform 0.2s ease;
      }
      .work-card:hover {
        border-color: var(--color-accent);
      }
      .work-media {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 10;
        background: #E8E2D5;
        overflow: hidden;
        border-bottom: 1px solid var(--color-border);
      }
      .work-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.3s ease;
      }
      .work-card:hover .work-media img {
        transform: scale(1.02);
      }
      .work-details {
        padding: var(--space-6);
        display: flex;
        flex-direction: column;
        flex: 1;
        text-align: left;
      }
      .work-title-wrap {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: var(--space-2);
        gap: var(--space-2);
      }
      .work-title {
        font-size: var(--font-size-h2);
        color: var(--color-text);
      }
      .work-arrow {
        color: var(--color-accent);
        font-size: var(--font-size-sm);
        font-family: var(--font-sans);
        font-weight: 600;
        white-space: nowrap;
      }
      .work-desc {
        font-size: var(--font-size-body);
        color: var(--color-text-muted);
        line-height: 1.55;
      }

      /* Decision Frameworks (Hidden when frameworks.json is empty) */
      .frameworks-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: var(--space-6);
      }
      .framework-card {
        background: var(--color-bg-card);
        border: 1px solid var(--color-border);
        padding: var(--space-6);
        border-radius: 2px;
        text-align: left;
      }
      .framework-image-wrap {
        position: relative;
        margin-bottom: var(--space-4);
        border: 1px solid var(--color-border);
        border-radius: 2px;
        overflow: hidden;
      }
      .framework-image-wrap img {
        width: 100%;
        height: auto;
        display: block;
      }
      .framework-client-label {
        position: absolute;
        top: var(--space-2);
        left: var(--space-2);
        background: rgba(26, 26, 26, 0.85);
        color: #FFFFFF;
        font-size: var(--font-size-xs);
        padding: 0.2rem 0.5rem;
        border-radius: 2px;
      }
      .framework-overlay-decision {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: rgba(26, 26, 26, 0.88);
        color: #FFFFFF;
        font-size: var(--font-size-xs);
        padding: var(--space-2) var(--space-3);
      }
      .framework-field {
        margin-top: var(--space-3);
        font-size: var(--font-size-body);
      }
      .framework-label {
        font-weight: 600;
        color: var(--color-text);
      }

      /* Background Section */
      .background-card {
        border-left: 2px solid var(--color-border-dark);
        padding-left: var(--space-6);
        text-align: left;
        max-width: 760px;
      }
      .background-text {
        font-size: var(--font-size-lead);
        color: var(--color-text);
        line-height: 1.6;
      }

      /* Contact Section */
      .contact-content {
        max-width: 680px;
        text-align: left;
      }
      .contact-statement {
        font-family: var(--font-serif);
        font-size: var(--font-size-h2);
        color: var(--color-text);
        line-height: 1.25;
        margin-bottom: var(--space-6);
      }
      .contact-links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-6);
        align-items: center;
        list-style: none;
      }
      .contact-link {
        font-family: var(--font-sans);
        font-size: var(--font-size-lead);
        font-weight: 600;
        color: var(--color-accent);
        text-decoration: underline;
        text-underline-offset: 4px;
        min-height: 44px;
        display: inline-flex;
        align-items: center;
      }
      .contact-link:hover {
        color: var(--color-accent-hover);
      }

      /* 404 Page */
      .error-page-section {
        padding-top: var(--space-20);
        padding-bottom: var(--space-20);
        text-align: left;
        max-width: 600px;
      }
      .error-heading {
        font-size: var(--font-size-hero);
        margin-bottom: var(--space-4);
      }
      .error-line {
        font-size: var(--font-size-lead);
        color: var(--color-text-muted);
        margin-bottom: var(--space-8);
      }
      .error-links {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        list-style: none;
      }
      .error-links a {
        font-size: var(--font-size-body);
        font-weight: 600;
        color: var(--color-accent);
        text-decoration: underline;
        text-underline-offset: 4px;
        min-height: 44px;
        display: inline-flex;
        align-items: center;
      }

      /* Footer */
      .site-footer {
        border-top: 1px solid var(--color-border);
        padding-top: var(--space-8);
        padding-bottom: var(--space-8);
        margin-top: auto;
      }
      .footer-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--space-4);
      }
      .footer-copy {
        font-size: var(--font-size-sm);
        color: var(--color-text-faint);
      }
      .footer-top-link {
        font-size: var(--font-size-sm);
        font-weight: 500;
        color: var(--color-text-muted);
        text-decoration: none;
        min-height: 44px;
        display: inline-flex;
        align-items: center;
      }
      .footer-top-link:hover {
        color: var(--color-accent);
      }

      /* Motion (Strictly Respects prefers-reduced-motion) */
      @media (prefers-reduced-motion: no-preference) {
        .reveal-on-scroll {
          opacity: 0;
          transform: translateY(12px);
          transition: opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1), transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
          will-change: opacity, transform;
        }
        .reveal-on-scroll.is-revealed {
          opacity: 1;
          transform: translateY(0);
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .reveal-on-scroll {
          opacity: 1 !important;
          transform: none !important;
          transition: none !important;
        }
      }

      /* Responsive Breakpoints (Mobile First) */
      @media (max-width: 840px) {
        .what-i-do-grid {
          grid-template-columns: 1fr;
          gap: var(--space-8);
        }
        .work-grid {
          grid-template-columns: 1fr;
          gap: var(--space-8);
        }
        .site-header .site-nav {
          display: none; /* Clean compact mobile header */
        }
      }
    </style>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <header class="site-header" role="banner">
      <div class="site-container header-inner">
        <a href="/" class="site-brand" aria-label="Ahmad Farooq homepage">
          <span class="site-brand-dot" aria-hidden="true"></span>
          <span>Ahmad Farooq</span>
        </a>
        <nav class="site-nav" aria-label="Primary navigation">
          <ul>
            <li><a href="/#what-i-do">What I do</a></li>
            <li><a href="/#work">Selected work</a></li>
            {hasFrameworks && <li><a href="/#frameworks">Decision frameworks</a></li>}
            <li><a href="/#background">Background</a></li>
            <li><a href="/#contact">Contact</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer" role="contentinfo">
      <div class="site-container footer-inner">
        <p class="footer-copy">&copy; {new Date().getFullYear()} Ahmad Farooq</p>
        <a href="#main-content" class="footer-top-link">Back to top &uarr;</a>
      </div>
    </footer>

    <!-- Minimal Scroll Reveal (Respects prefers-reduced-motion) -->
    <script is:inline>
      (function() {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var reveals = document.querySelectorAll('.reveal-on-scroll');
        if (!('IntersectionObserver' in window)) {
          reveals.forEach(function(el) { el.classList.add('is-revealed'); });
          return;
        }
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1 });
        reveals.forEach(function(el) { observer.observe(el); });
      })();
    </script>
  </body>
</html>
