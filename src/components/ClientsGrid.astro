---
import settings from '../content/global/settings.json';
---

<section class="section" aria-labelledby="clients-heading" style="padding-top: 40px; padding-bottom: 40px;">
  <div class="container">
    <div class="section-header reveal" style="margin-bottom: 24px;">
      <span class="section-label">Proof</span>
      <h2 id="clients-heading">Worked with.</h2>
    </div>
    <div class="clients-grid reveal">
      {settings.clients.map(client => (
        <div class="client-item">{client.name}</div>
      ))}
    </div>
  </div>
</section>
